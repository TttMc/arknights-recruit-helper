<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/ak_inset" />
                    <stroke android:width="1dp" android:color="@color/ak_amber" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ak_inset" />
            <stroke android:width="1dp" android:color="@color/ak_line2" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
